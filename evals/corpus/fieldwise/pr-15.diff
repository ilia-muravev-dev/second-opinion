+def split_evidence(data: dict[str, Any]) -> tuple[dict[str, Any], dict[str, Any] | None]:
+    """{"fields": ..., "evidence": ...} → (fields, evidence); plain results pass through."""
+    if set(data) == {"fields", "evidence"} and isinstance(data["fields"], dict):
