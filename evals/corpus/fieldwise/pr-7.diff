diff --git a/docker-compose.yml b/docker-compose.yml
index 8796bd1..838f941 100644
--- a/docker-compose.yml
+++ b/docker-compose.yml
@@ -1,3 +1,21 @@
+x-backend: &backend
+  build: ./backend
+  env_file:
+    - path: ./backend/.env
+      required: false
+  environment:
+    DATABASE_URL: postgresql+psycopg://fieldwise:fieldwise@db:5432/fieldwise
+    REDIS_URL: redis://redis:6379/0
+    STORAGE_URL: file:///data/storage
+  volumes:
+    - ./backend/data/storage:/data/storage   # shared with the CLI running on the host
+    - models:/models
+  depends_on:
+    db:
+      condition: service_healthy
+    redis:
+      condition: service_healthy
+
 services:
   db:
     image: pgvector/pgvector:pg17
@@ -25,5 +43,34 @@ services:
       timeout: 3s
       retries: 10
 
+  migrate:
+    <<: *backend
+    profiles: [app]
+    command: sh -c "fieldwise db upgrade && fieldwise schemas sync"
+    restart: "no"
+
+  api:
+    <<: *backend
+    profiles: [app]
+    ports:
+      - "8000:8000"
+    depends_on:
+      migrate:
+        condition: service_completed_successfully
+    healthcheck:
+      test: ["CMD-SHELL", "python -c \"import urllib.request; urllib.request.urlopen('http://localhost:8000/health')\""]
+      interval: 10s
+      timeout: 5s
+      retries: 10
+
+  worker:
+    <<: *backend
+    profiles: [app]
+    command: celery -A fieldwise.worker.app:celery_app worker --loglevel=info --concurrency=2
+    depends_on:
+      migrate:
+        condition: service_completed_successfully
+
 volumes:
   db-data:
+  models:
diff --git a/justfile b/justfile
index 6b9b53f..c5d6c4a 100644
--- a/justfile
+++ b/justfile
@@ -7,9 +7,13 @@ default:
 up:
     docker compose up -d --wait db redis
 
+# Start everything: database, redis, migrations, API, worker (and the web app when present)
+app:
+    docker compose --profile app up -d --build --wait
+
 # Stop everything
 down:
-    docker compose down
+    docker compose --profile app down
 
 # Lint, types and tests for the backend
 backend-check:
@@ -19,9 +23,21 @@ backend-check:
 backend-fix:
     cd backend && uv run ruff check --fix . && uv run ruff format .
 
+# Regenerate the API contract the web client is built from
+openapi:
+    cd backend && uv run fieldwise openapi ../openapi.json
+
+# Fail when openapi.json is stale (CI runs this)
+openapi-check:
+    cd backend && uv run fieldwise openapi /tmp/fieldwise-openapi.json >/dev/null && diff -q /tmp/fieldwise-openapi.json ../openapi.json
+
 # Everything CI runs
-check: backend-check
+check: backend-check openapi-check
 
 # Run the API locally with reload
 api:
     cd backend && uv run uvicorn fieldwise.api.app:app --reload --port 8000
+
+# Run the worker locally
+worker:
+    cd backend && uv run celery -A fieldwise.worker.app:celery_app worker --loglevel=info --concurrency=2
