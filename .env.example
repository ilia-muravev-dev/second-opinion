# Copy to .env (gitignored). Every variable is prefixed SO_.
SO_PROVIDER=openai                      # anthropic | openai (OpenRouter, Ollama, any OpenAI-compatible endpoint) | fake
SO_MODEL=deepseek/deepseek-v4-flash-0731:free   # any model the provider serves
SO_PROMPT_VERSION=v1
# SO_ANTHROPIC_API_KEY=sk-ant-...
# SO_OPENAI_API_KEY=sk-or-...           # OpenRouter key
SO_OPENAI_BASE_URL=https://openrouter.ai/api/v1
# SO_GITHUB_TOKEN=ghp_...               # only for `review --pr` outside Actions
