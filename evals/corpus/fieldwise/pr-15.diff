+def test_split_evidence() -> None:
+    fields, evidence = split_evidence(
+        {"fields": {"total": 1}, "evidence": {"total": "TOTAL 1", "tax": ""}}
+    )
+    assert fields == {"total": 1}
+    assert evidence == {"total": "TOTAL 1"}
+    assert split_evidence({"total": 1}) == ({"total": 1}, None)
